def Erdos771.AvoidsSubsetSum : ℕ → Finset ℕ → Prop :=
fun m S => m ∉ S.subsetSum
def Erdos771.AdmissibleCard : ℕ → ℕ → Prop :=
fun n k => ∀ (m : ℕ), 0 < m → ∃ S ⊆ Finset.Icc 1 n, S.card = k ∧ Erdos771.AvoidsSubsetSum m S
def Erdos771.erdosF : ℕ → ℕ :=
fun n => Nat.findGreatest (Erdos771.AdmissibleCard n) n
